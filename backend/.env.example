# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vision & Models
MODEL_NAME=sface
DETECTOR_NAME=yunet
EMBEDDING_DIM=128
MODELS_DIR=data/models

# Storage & Privacy
UPLOAD_MAX_BYTES=10485760
TEMP_UPLOAD_DIR=backend/temp
EPHEMERAL_CLEANUP_SECONDS=300
DATABASE_URL=sqlite:///./data/doppelganger.db

# Optional GenAI Service (Graceful fallback if absent)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
